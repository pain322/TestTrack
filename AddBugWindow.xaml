<Window x:Class="TestTrack.AddBugWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавление ошибки"
        Height="700" Width="650"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="Новая ошибка"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#202A44"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Название ошибки"/>
            <TextBox x:Name="TitleBox" Margin="0,6,0,14"
                     Padding="10" FontSize="14"/>

            <TextBlock Text="Описание"/>
            <TextBox x:Name="DescriptionBox" Margin="0,6,0,14"
                     Padding="10" Height="65"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Шаги воспроизведения"/>
            <TextBox x:Name="StepsBox" Margin="0,6,0,14"
                     Padding="10" Height="75"
                     AcceptsReturn="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Ожидаемый результат"/>
            <TextBox x:Name="ExpectedBox" Margin="0,6,0,14"
                     Padding="10" Height="50"
                     AcceptsReturn="True" TextWrapping="Wrap"/>

            <TextBlock Text="Фактический результат"/>
            <TextBox x:Name="ActualBox" Margin="0,6,0,14"
                     Padding="10" Height="50"
                     AcceptsReturn="True" TextWrapping="Wrap" />

            <TextBlock Text="Приоритет"/>
            <ComboBox x:Name="PriorityBox" Margin="0,6,0,14"
                      Padding="8" SelectedIndex="1">
                <ComboBoxItem Content="Низкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Высокий"/>
                <ComboBoxItem Content="Критический"/>
            </ComboBox>

            <TextBlock Text="Модуль приложения"/>

            <ComboBox x:Name="ModuleBox"
          Margin="0,6,0,20"
          Padding="8"
          DisplayMemberPath="Name"
          SelectedValuePath="Id"/>








            <Button Content="Сохранить ошибку"
                    Height="42"
                    Background="#3659D9"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>








