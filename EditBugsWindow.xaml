<Window x:Class="TestTrack.EditBugsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Редактирование ошибки"
        Height="570" Width="600"
        WindowStartupLocation="CenterOwner"
        Background="#F3F5F9"
        ResizeMode="NoResize">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="25">
            <TextBlock Text="Редактирование ошибки"
                       FontSize="25"
                       FontWeight="Bold"
                       Margin="0,0,0,20"/>

            <TextBlock Text="Название"/>
            <TextBox x:Name="TitleBox"
                     Margin="0,5,0,12"
                     Padding="8"/>

            <TextBlock Text="Описание"/>
            <TextBox x:Name="DescriptionBox"
                     Margin="0,5,0,12"
                     Padding="8"
                     Height="70"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"/>

            <TextBlock Text="Статус"/>
            <ComboBox x:Name="StatusBox"
                      Margin="0,5,0,12"
                      Padding="8">
                <ComboBoxItem Content="Новая"/>
                <ComboBoxItem Content="В работе"/>
                <ComboBoxItem Content="Исправлена"/>
                <ComboBoxItem Content="Закрыта"/>
            </ComboBox>

            <TextBlock Text="Приоритет"/>
            <ComboBox x:Name="PriorityBox"
                      Margin="0,5,0,20"
                      Padding="8">
                <ComboBoxItem Content="Низкий"/>
                <ComboBoxItem Content="Средний"/>
                <ComboBoxItem Content="Высокий"/>
                <ComboBoxItem Content="Критический"/>
            </ComboBox>

            <Button Content="Сохранить изменения"
                    Height="42"
                    Background="#3659D9"
                    Foreground="White"
                    FontWeight="Bold"
                    Click="SaveButton_Click"/>
        </StackPanel>
    </ScrollViewer>
</Window>