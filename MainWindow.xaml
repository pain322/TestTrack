<Window x:Class="TestTrack.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TestTrack — отслеживание ошибок"
        Height="720"
        Width="1150"
        MinHeight="600"
        MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9">

    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#3157D5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E9EDF5"/>
            <Setter Property="Foreground" Value="#27324A"/>
            <Setter Property="Padding" Value="10,12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,22">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="TestTrack"
                           FontSize="30"
                           FontWeight="Bold"
                           Foreground="#17233D"/>

                <TextBlock Text="Система отслеживания ошибок тестирования"
                           FontSize="14"
                           Foreground="#68738A"
                           Margin="0,5,0,0"/>
            </StackPanel>

            <Button Grid.Column="1"
                    Content="Обновить"
                    Width="115"
                    Height="38"
                    VerticalAlignment="Center"
                    Click="RefreshButton_Click"/>
        </Grid>

        <!-- Статистика -->
        <UniformGrid Grid.Row="1"
                     Columns="3"
                     Margin="0,0,0,22">

            <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="0,0,10,0">

                <StackPanel>
                    <TextBlock Text="Всего ошибок"
                               Foreground="#68738A"
                               FontSize="14"/>

                    <TextBlock x:Name="TotalBugsText"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#3157D5"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="5,0">

                <StackPanel>
                    <TextBlock Text="Новые ошибки"
                               Foreground="#68738A"
                               FontSize="14"/>

                    <TextBlock x:Name="NewBugsText"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#D97706"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>

            <Border Background="White"
                    CornerRadius="10"
                    Padding="18"
                    Margin="10,0,0,0">

                <StackPanel>
                    <TextBlock Text="Исправленные ошибки"
                               Foreground="#68738A"
                               FontSize="14"/>

                    <TextBlock x:Name="FixedBugsText"
                               Text="0"
                               FontSize="30"
                               FontWeight="Bold"
                               Foreground="#16845B"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </UniformGrid>

        <!-- Поиск и управление ошибками -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="12"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="SearchBox"
                         Height="38"
                         VerticalContentAlignment="Center"
                         Padding="10,5"
                         Margin="4"
                         FontSize="14"
                         ToolTip="Поиск по названию или описанию"
                         Text=""/>

                <ComboBox x:Name="StatusFilterBox"
                          Grid.Column="1"
                          Height="38"
                          Margin="4"
                          VerticalContentAlignment="Center">

                    <ComboBoxItem Content="Все"
                                  IsSelected="True"/>
                    <ComboBoxItem Content="Новая"/>
                    <ComboBoxItem Content="В работе"/>
                    <ComboBoxItem Content="Исправлена"/>
                    <ComboBoxItem Content="Закрыта"/>
                </ComboBox>

                <Button Grid.Column="2"
                        Content="Найти"
                        Height="38"
                        Click="SearchButton_Click"/>

                <Button Grid.Column="3"
                        Content="Добавить ошибку"
                        Height="38"
                        Click="AddBugButton_Click"/>

                <Button Grid.Column="4"
                        Content="Редактировать"
                        Height="38"
                        Click="EditBugButton_Click"/>

                <Button Grid.Column="5"
                        Content="Удалить"
                        Height="38"
                        Background="#DC3545"
                        Foreground="White"
                        Click="DeleteBugButton_Click"/>
            </Grid>
        </Border>

        <!-- Таблица ошибок -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="10">

            <DataGrid x:Name="BugsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="#E8ECF3"
                      Background="White"
                      BorderThickness="0"
                      RowHeight="42"
                      FontSize="13">

                <DataGrid.Columns>

                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="55"/>

                    <DataGridTextColumn Header="Название ошибки"
                                        Binding="{Binding Title}"
                                        Width="2*"/>

                    <DataGridTextColumn Header="Статус"
                                        Binding="{Binding Status}"
                                        Width="120"/>

                    <DataGridTextColumn Header="Приоритет"
                                        Binding="{Binding Priority}"
                                        Width="115"/>

                    <DataGridTextColumn Header="Модуль"
                                        Binding="{Binding ModuleName}"
                                        Width="1.5*"/>

                    <DataGridTextColumn Header="Автор"
                                        Binding="{Binding ReporterName}"
                                        Width="1.2*"/>

                    <DataGridTextColumn Header="Исполнитель"
                                        Binding="{Binding AssigneeName}"
                                        Width="1.2*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </Grid>
</Window>
